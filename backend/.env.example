# HIVE Environment Configuration — Analyze. Evaluate. Evolve.
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database settings (SQLite local database)
# Default: backend/hive.db. For an existing database, set DATABASE_URL explicitly.
# DATABASE_URL=sqlite:///./hive.db

# Market Data Mode & Provider (LIVE_ONLY, 0xramm_yahoo_rest)
MARKET_DATA_PROVIDER=0xramm_yahoo_rest
MARKET_DATA_BASE_URL=http://127.0.0.1:8787
MARKET_DATA_RESPONSE_MODE=num
MARKET_DATA_POLL_INTERVAL_SECONDS=15
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=8
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_STALE_AFTER_SECONDS=60
MARKET_DATA_TIMEZONE=Asia/Kolkata
MARKET_DATA_MODE=LIVE_ONLY
MARKET_DATA_ALLOW_HISTORICAL_FALLBACK=false
MARKET_DATA_ALLOW_SYNTHETIC_MARKET_DATA=false

ALLOW_HISTORICAL_MARKET_FALLBACK=false
ALLOW_SYNTHETIC_MARKET_DATA=false
SYNTHETIC_RANDOM_SEED=42

# 0xramm Indian Stock Market API Provisional REST Adapter Aliases
RAM_STOCK_API_BASE_URL=http://127.0.0.1:8787
RAM_POLL_INTERVAL_SECONDS=15.0
RAM_REQUEST_TIMEOUT_SECONDS=8.0
RAM_MAX_RETRIES=2
RAM_BACKOFF_FACTOR=1.5
RAM_STALENESS_THRESHOLD_SECONDS=60.0
RAM_FEED_ENABLED=true
RAM_EMBEDDED_FALLBACK=true

# Optional DhanHQ-py Live Market Feed Settings
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_FEED_ENABLED=false
DHAN_FEED_MODE=QUOTE
DHAN_STALENESS_THRESHOLD_SECONDS=15.0

# Optional Local LLM via Ollama (No Cloud / Paid APIs)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
HIVE_EXECUTOR_MODEL=qwen3.5:4b
HIVE_REVIEWER_MODEL=hf.co/unsloth/gemma-3-4b-it-GGUF:Q4_K_M
HIVE_MODEL_TIMEOUT_SECONDS=45
HIVE_MODEL_KEEP_ALIVE=0
HIVE_MAX_REVISION_ATTEMPTS=1
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=45.0

# Simulation Default Parameters
INITIAL_CASH=1000000.0
INITIAL_EQUITY=1000000.0
TRANSACTION_FEE_PCT=0.1
COMMISSION_PCT=0.1
SLIPPAGE_PCT=0.05
MAX_ORDER_PCT=10.0
MAX_ALLOCATION_PCT=25.0
MAX_DRAWDOWN_PCT=10.0
AUTO_EXECUTE=true

# Optional local operator token. Required for prompt approval/activation/rollback.
HIVE_OPERATOR_TOKEN=
